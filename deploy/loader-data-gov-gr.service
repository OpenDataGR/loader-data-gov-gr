[Unit]
Description=loader-data-gov-gr (providerharvest-service)
After=network.target

[Service]
User=localadmin
WorkingDirectory=/opt/data-projects/loader-data-gov-gr
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/data-projects/loader-data-gov-gr/venv/bin/gunicorn -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:5002 providerharvest_service.app:app
Restart=always

[Install]
WantedBy=multi-user.target
